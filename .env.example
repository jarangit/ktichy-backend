# Server
PORT=3000
CLIENT_URL=http://localhost:5173

# DB
DB_HOST=localhost
DB_PORT=3366
DB_USER=kitchy_user
DB_PASS=password
DB_NAME=kitchy_db
# Optional: only set if this app must force a specific MySQL session timezone.
# Example for Thailand-only local dev: DB_TIMEZONE=+07:00
# Leave unset in environments where DB/session timezone is already correct.

# Auth
JWT_SECRET=kitchy_secret
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com  # for google-login (OAuth) - no file needed

# GCS - Storage for product images
GCS_PROJECT_ID=my-pos-505806
GCS_BUCKET=kitchy-product-images

# Local dev (file-based, works because secrets/ exists locally):
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcs-service-account.json

# Railway / Production (no file system) - use ONE of these instead of GOOGLE_APPLICATION_CREDENTIALS:
# Option A - raw JSON (paste whole service-account.json content, watch \n in private_key):
# GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"my-pos-505806",...}
# Option B - base64 (recommended for Railway - avoids newline escaping):
# cat secrets/gcs-service-account.json | base64 -w0
# GCS_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiw...
# GOOGLE_APPLICATION_CREDENTIALS_JSON / GOOGLE_APPLICATION_CREDENTIALS_BASE64 also supported as aliases
